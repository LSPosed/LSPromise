<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >
<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Run userspace exploit"
        android:id="@+id/exploit"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="patchMod"
        android:visibility="gone"
        android:id="@+id/patchMod"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="patchLibc"
        android:visibility="gone"
        android:id="@+id/patchLibc"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="patchCxx"
        android:visibility="gone"
        android:id="@+id/patchCxx"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Run kernel exploit and load KernelSU"
        android:visibility="gone"
        android:id="@+id/patchAll"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="copy text"
        android:id="@+id/copyAll"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="forkProcess"
        android:visibility="gone"
        android:id="@+id/forkProcess"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/status" />
</LinearLayout>
</ScrollView>
